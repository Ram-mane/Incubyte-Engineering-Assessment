<?xml version="1.0"?>
<ruleset name="salary-management"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>
    Bug-finding rules only. Style is Spotless's job and structure is Checkstyle's, so PMD
    is pointed at the categories that catch defects rather than preferences.
  </description>

  <rule ref="category/java/errorprone.xml">
    <!--
      MissingSerialVersionUID fires on every domain exception, because Throwable is Serializable.
      These exceptions are thrown, caught and mapped to an HTTP problem response inside one
      process - they are never written to a stream, so no reader of a serialised form can be
      broken by changing them. The constant would be a number nobody will ever bump: a
      maintenance signal that means nothing, which is worse than its absence.
    -->
    <exclude name="MissingSerialVersionUID"/>
    <!--
      AvoidFieldNameMatchingMethodName fires on every accessor named after its field - which is
      the convention this codebase uses everywhere, because that is what a record generates.
      Every record here already has that shape; PMD cannot see generated accessors, so the rule
      only ever fires on the one aggregate written by hand. Renaming Employee.id() to getId() to
      satisfy it would make the hand-written class the odd one out.
    -->
    <exclude name="AvoidFieldNameMatchingMethodName"/>
  </rule>

  <!-- Kept everywhere else: a genuinely serialised class does need one. -->
  <rule ref="category/java/errorprone.xml/MissingSerialVersionUID">
    <properties>
      <property name="violationSuppressXPath"
                value="//ClassDeclaration[ends-with(@SimpleName, 'Exception')]"/>
    </properties>
  </rule>

  <rule ref="category/java/bestpractices.xml"/>
</ruleset>
